{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DebugShrine Classification v1.0",
  "type": "object",
  "required": ["GovernanceFlag", "RouteError", "Classification"],
  "properties": {
    "GovernanceFlag": { "type": "boolean" },
    "RouteError": { "type": "boolean" },
    "Classification": {
      "type": "string",
      "enum": ["GOVERNANCE", "BOUNDARY", "NORMAL"]
    }
  },
  "oneOf": [
    {
      "required": ["GovernanceFlag", "Classification"],
      "properties": {
        "GovernanceFlag": { "const": true },
        "Classification": { "const": "GOVERNANCE" }
      }
    },
    {
      "required": ["GovernanceFlag", "RouteError", "Classification"],
      "properties": {
        "GovernanceFlag": { "const": false },
        "RouteError": { "const": true },
        "Classification": { "const": "BOUNDARY" }
      }
    },
    {
      "required": ["GovernanceFlag", "RouteError", "Classification"],
      "properties": {
        "GovernanceFlag": { "const": false },
        "RouteError": { "const": false },
        "Classification": { "const": "NORMAL" }
      }
    }
  ]
}
